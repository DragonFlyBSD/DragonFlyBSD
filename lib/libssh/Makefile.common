.include <bsd.dragonfly.mk>

LIBSSH_SDIR=	${DF.SRCTOP}/lib/libssh
LIBSSH_ODIR=	${DF.OBJTOP}/lib/libssh

OPENSSHDIR=	${DF.SRCTOP}/crypto/openssh

.PATH: ${LIBSSH_ODIR}	# find the generated manpages here
.PATH: ${OPENSSHDIR}

CFLAGS+=	-I${LIBSSH_ODIR}
CFLAGS+=	-I${OPENSSHDIR}

# for includes.h including <openssl/opensslv.h>
CFLAGS+=	${PRIVATELIB_CFLAGS}

.if ${.CURDIR} != ${LIBSSH_SDIR}
LIBSSH=		${LIBSSH_ODIR}/libssh.a
DPADD+=		${LIBSSH}
LDADD+=		${LIBSSH}
.endif
