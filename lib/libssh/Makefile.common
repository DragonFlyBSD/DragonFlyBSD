LIBSSH_RELDIR?=
LIBSSH_SDIR=	${.CURDIR}/${LIBSSH_RELDIR}
LIBSSH_ODIR=	${.OBJDIR}/${LIBSSH_RELDIR}

OPENSSHDIR=	${LIBSSH_SDIR}/../../crypto/openssh

.PATH: ${LIBSSH_ODIR}	# find the generated manpages here
.PATH: ${OPENSSHDIR}

CFLAGS+=	-I${LIBSSH_ODIR}
CFLAGS+=	-I${OPENSSHDIR}

# for includes.h including <openssl/opensslv.h>
CFLAGS+=	${PRIVATELIB_CFLAGS}

.if ${LIBSSH_RELDIR} != ""
LIBSSH=		${LIBSSH_ODIR}/libssh.a
DPADD+=		${LIBSSH}
LDADD+=		${LIBSSH}
.endif
