define MC_RCX offsetof(mcontext_t, mc_rcx)
define MC_R8 offsetof(mcontext_t, mc_r8)
define MC_R9 offsetof(mcontext_t, mc_r9)
define MC_RAX offsetof(mcontext_t, mc_rax)
define MC_RBX offsetof(mcontext_t, mc_rbx)
define MC_RBP offsetof(mcontext_t, mc_rbp)
define MC_R10 offsetof(mcontext_t, mc_r10)
define MC_R11 offsetof(mcontext_t, mc_r11)
define MC_R12 offsetof(mcontext_t, mc_r12)
define MC_R13 offsetof(mcontext_t, mc_r13)
define MC_R14 offsetof(mcontext_t, mc_r14)
define MC_R15 offsetof(mcontext_t, mc_r15)
define MC_RIP offsetof(mcontext_t, mc_rip)
define MC_CS offsetof(mcontext_t, mc_cs)
define MC_RFLAGS offsetof(mcontext_t, mc_rflags)
define MC_RSP offsetof(mcontext_t, mc_rsp)
define MC_SS offsetof(mcontext_t, mc_ss)
define _MC_FPOWNED_NONE _MC_FPOWNED_NONE
define _MC_FPFMT_NODEV _MC_FPFMT_NODEV
