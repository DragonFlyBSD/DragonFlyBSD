LIBSSH_RELDIR=	../../lib/libssh
.include "${LIBSSH_RELDIR}/Makefile.common"

FILES=		sshd_config
FILESDIR=	/etc/ssh
FILESMODE=	644
FILESOWN=	${BINOWN}
FILESGRP=	${BINGRP}

# Explicitly disable PasswordAuthentication
sshd_config: ${OPENSSHDIR}/sshd_config
	sed -E -e 's|^#?PasswordAuthentication.*$$|PasswordAuthentication no|' \
	    ${.ALLSRC} > ${.TARGET}

CLEANFILES+=	sshd_config

.include <bsd.prog.mk>
