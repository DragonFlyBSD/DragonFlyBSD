include <sys/param.h>
include <sys/proc.h>
include <sys/cpumask.h>
include <vm/vm_map.h>

include <machine/tss.h>
include <machine/sigframe.h>
include <machine/globaldata.h>
include <machine/pcb.h>
include <machine/pmap.h>

define VM_PMAP offsetof(struct vmspace, vm_pmap)
define PM_ACTIVE offsetof(struct pmap, pm_active)
define PM_ACTIVE_LOCK offsetof(struct pmap, pm_active_lock)

define LWP_VMSPACE offsetof(struct lwp, lwp_vmspace)
define GD_CURTHREAD offsetof(struct mdglobaldata, mi.gd_curthread)
define GD_CPUID offsetof(struct mdglobaldata, mi.gd_cpuid)
define GD_CPUMASK offsetof(struct mdglobaldata, mi.gd_cpumask)
define GD_OTHER_CPUS offsetof(struct mdglobaldata, mi.gd_other_cpus)

define CPULOCK_EXCLBIT CPULOCK_EXCLBIT
define CPULOCK_EXCL CPULOCK_EXCL
define CPULOCK_INCR CPULOCK_INCR
define CPULOCK_CNTMASK CPULOCK_CNTMASK

define PCB_R15 offsetof(struct pcb, pcb_r15)
define PCB_R14 offsetof(struct pcb, pcb_r14)
define PCB_R13 offsetof(struct pcb, pcb_r13)
define PCB_R12 offsetof(struct pcb, pcb_r12)
define PCB_RBP offsetof(struct pcb, pcb_rbp)
define PCB_RSP offsetof(struct pcb, pcb_rsp)
define PCB_RBX offsetof(struct pcb, pcb_rbx)
define PCB_RIP offsetof(struct pcb, pcb_rip)
define TSS_RSP0 offsetof(struct x86_64tss, tss_rsp0)

define PCB_DR0 offsetof(struct pcb, pcb_dr0)
define PCB_DR1 offsetof(struct pcb, pcb_dr1)
define PCB_DR2 offsetof(struct pcb, pcb_dr2)
define PCB_DR3 offsetof(struct pcb, pcb_dr3)
define PCB_DR6 offsetof(struct pcb, pcb_dr6)
define PCB_DR7 offsetof(struct pcb, pcb_dr7)
define PCB_DBREGS PCB_DBREGS
define PCB_FLAGS offsetof(struct pcb, pcb_flags)
define PCB_FSBASE offsetof(struct pcb, pcb_fsbase)
define PCB_GSBASE offsetof(struct pcb, pcb_gsbase)
define PCB_SAVEFPU offsetof(struct pcb, pcb_save)

define PCB_SAVEFPU_SIZE sizeof(union savefpu)
define SIGF_HANDLER offsetof(struct sigframe, sf_ahu.sf_handler)
define SIGF_UC offsetof(struct sigframe, sf_uc)

define TD_LWP offsetof(struct thread, td_lwp)
define TD_PCB offsetof(struct thread, td_pcb)
define TD_SP offsetof(struct thread, td_sp)
define TD_PRI offsetof(struct thread, td_pri)
define TD_CRITCOUNT offsetof(struct thread, td_critcount)
define TD_FLAGS offsetof(struct thread, td_flags)
define TD_SAVEFPU offsetof(struct thread, td_savefpu)
define TDF_RUNNING TDF_RUNNING
define GD_NPXTHREAD offsetof(struct mdglobaldata, gd_npxthread)
